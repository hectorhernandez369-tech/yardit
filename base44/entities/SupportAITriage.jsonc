{
  "name": "SupportAITriage",
  "type": "object",
  "properties": {
    "source_type": {
      "type": "string",
      "enum": [
        "support_ticket",
        "report"
      ],
      "description": "Source being triaged"
    },
    "source_id": {
      "type": "string",
      "description": "SupportTicket or Report ID"
    },
    "source_number": {
      "type": "string",
      "description": "Ticket number or report reference when available"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "safety_flag": {
      "type": "boolean",
      "default": false
    },
    "safety_reason": {
      "type": "string",
      "description": "Plain-English reason for safety escalation"
    },
    "category": {
      "type": "string",
      "description": "AI/deterministic triage category"
    },
    "summary": {
      "type": "string",
      "description": "Short internal summary"
    },
    "suggested_action": {
      "type": "string",
      "description": "Recommended next internal action"
    },
    "suggested_reply": {
      "type": "string",
      "description": "Draft customer reply for support tickets"
    },
    "requires_human": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "actioned",
        "dismissed"
      ],
      "default": "new"
    },
    "email_alert_sent": {
      "type": "boolean",
      "default": false
    },
    "email_alert_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source_type",
    "source_id",
    "priority",
    "safety_flag",
    "status",
    "last_scanned_at"
  ]
}
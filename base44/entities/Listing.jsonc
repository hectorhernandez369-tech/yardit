{
  "name": "Listing",
  "type": "object",
  "properties": {
    "ownerUserId": {
      "type": "string",
      "description": "ID of the user who owns this listing"
    },
    "listingNumber": {
      "type": "string",
      "description": "Formatted listing number e.g. CA3247-r2d2a"
    },
    "listingType": {
      "type": "string",
      "enum": [
        "yard_sale",
        "neighborhood_sale",
        "event"
      ],
      "description": "Type of listing"
    },
    "title": {
      "type": "string",
      "description": "Title of the listing"
    },
    "description": {
      "type": "string",
      "description": "Description of items/details"
    },
    "event_name": {
      "type": "string",
      "description": "Event name for event listings"
    },
    "event_description": {
      "type": "string",
      "description": "Event description for event listings"
    },
    "event_category": {
      "type": "string",
      "description": "Event category for event listings"
    },
    "event_icon": {
      "type": "string",
      "description": "Selected event icon key"
    },
    "event_logo_url": {
      "type": "string",
      "description": "Uploaded logo or image for premium event pins"
    },
    "event_tier": {
      "type": "string",
      "enum": [
        "basic",
        "featured",
        "premium",
        "marquee"
      ],
      "description": "Selected event visibility tier"
    },
    "event_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos for event listings"
    },
    "marquee_flyer_url": {
      "type": "string",
      "description": "Flyer image URL for marquee events (shown in listing details)"
    },
    "marquee_background_url": {
      "type": "string",
      "description": "Background image URL for marquee board on live map"
    },
    "marquee_schedule_slots": {
      "type": "array",
      "description": "Manual marquee schedule slots shown on the live map board",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "display_address": {
      "type": "string",
      "description": "Final user-facing address"
    },
    "geocoded_address": {
      "type": "string",
      "description": "Optional, internal/reference only geocoded address"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "search",
        "pin",
        "admin_selected"
      ],
      "default": "search",
      "description": "Source of the location data"
    },
    "address_text": {
      "type": "string",
      "description": "Event address text alias"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Event start datetime alias"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Event end datetime alias"
    },
    "addressText": {
      "type": "string",
      "description": "Full street address"
    },
    "city": {
      "type": "string",
      "description": "City name"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "zip": {
      "type": "string",
      "description": "ZIP code"
    },
    "lat": {
      "type": "number",
      "description": "Latitude"
    },
    "lng": {
      "type": "number",
      "description": "Longitude"
    },
    "timeZoneId": {
      "type": "string",
      "description": "IANA timezone for the listing location, e.g. America/Los_Angeles"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "featured",
        "premium",
        "marquee",
        "neighborhood_tier"
      ],
      "default": "free",
      "description": "Listing tier"
    },
    "pricePaid": {
      "type": "number",
      "default": 0,
      "description": "Amount paid for this listing"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "activated_locked",
        "scheduled",
        "hidden",
        "under_review",
        "suspended",
        "completed",
        "expired",
        "collecting_participants",
        "ready_for_payment",
        "payment_pending",
        "payment_pending_adjustment",
        "closed",
        "cancelled"
      ],
      "default": "active",
      "description": "Current status"
    },
    "event_state": {
      "type": "string",
      "enum": [
        "pending_activation",
        "activated",
        "activated_locked",
        "coming_soon",
        "active",
        "expired",
        "downgraded",
        "canceled"
      ],
      "description": "Normalized neighborhood sale event state"
    },
    "statusReason": {
      "type": "string",
      "description": "Reason for status change"
    },
    "statusUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Status expiration date"
    },
    "reportCount": {
      "type": "number",
      "default": 0,
      "description": "Number of reports"
    },
    "lastReportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last report timestamp"
    },
    "photoUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of photo URLs"
    },
    "category": {
      "type": "string",
      "description": "Main category of the listing"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of selected categories"
    },
    "collectible_type": {
      "type": "string",
      "description": "Type of collectible if category is Collectibles"
    },
    "selectedRangeStartDate": {
      "type": "string",
      "format": "date",
      "description": "The first day the user selected (local listing date)"
    },
    "selectedRangeEndDate": {
      "type": "string",
      "format": "date",
      "description": "The last day the user selected (local listing date)"
    },
    "earlyVisibilityDays": {
      "type": "number",
      "default": 0,
      "description": "Premium only: 0-3 early visibility days that come FIRST in the selected range"
    },
    "activeDates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Dates when listing is OPEN/ACTIVE (green)"
    },
    "earlyVisibilityDates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Dates when listing is visible but not OPEN (yellow)"
    },
    "startDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "Start datetime (computed) in listing timezone"
    },
    "endDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "End datetime (computed) in listing timezone"
    },
    "validatedDistance": {
      "type": "boolean",
      "default": false,
      "description": "Neighborhood validation"
    },
    "spanFeet": {
      "type": "number",
      "description": "Span in feet for neighborhood sales"
    },
    "validatedText": {
      "type": "boolean",
      "default": false,
      "description": "Text confirmation for neighborhood sales"
    },
    "homeCount": {
      "type": "number",
      "description": "Number of homes currently visible in the neighborhood sale"
    },
    "organizer_participation": {
      "type": "string",
      "enum": [
        "participating",
        "organizing_only"
      ],
      "default": "participating",
      "description": "Whether the organizer is also hosting a sale in their own neighborhood event"
    },
    "organizer_participant_listing_id": {
      "type": "string",
      "description": "Organizer's linked personal yard sale listing ID, if participating"
    },
    "neighborhood_join_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "denied"
      ],
      "description": "Status of joining a neighborhood sale"
    },
    "payment_intent_status": {
      "type": "string",
      "enum": [
        "none",
        "hold_requested",
        "voided",
        "captured"
      ],
      "description": "Status of the payment hold"
    },
    "hold_deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for the payment hold"
    },
    "neighborhood_sale_id": {
      "type": "string",
      "description": "ID of the associated neighborhood sale"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "description": "Listing activation status"
    },
    "is_demo_listing": {
      "type": "boolean",
      "default": false,
      "description": "Flag for demo listings"
    },
    "invite_code": {
      "type": "string",
      "description": "Invite code for neighborhood sale sharing"
    },
    "event_center_lat": {
      "type": "number",
      "description": "Neighborhood event center latitude"
    },
    "event_center_lng": {
      "type": "number",
      "description": "Neighborhood event center longitude"
    },
    "host_mode": {
      "type": "string",
      "enum": [
        "self",
        "cohost"
      ],
      "description": "How the host address was selected"
    },
    "host_addressText": {
      "type": "string",
      "description": "Confirmed host street address"
    },
    "host_city": {
      "type": "string",
      "description": "Confirmed host city"
    },
    "host_state": {
      "type": "string",
      "description": "Confirmed host state"
    },
    "host_zip": {
      "type": "string",
      "description": "Confirmed host ZIP"
    },
    "host_address_lat": {
      "type": "number",
      "description": "Confirmed host latitude"
    },
    "host_address_lng": {
      "type": "number",
      "description": "Confirmed host longitude"
    },
    "cohost_invite_id": {
      "type": "string",
      "description": "Co-host invite ID if alternate host flow is used"
    },
    "cohost_invite_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "description": "Co-host invite status"
    },
    "co_host_user_id": {
      "type": "string",
      "description": "Accepted co-host user ID for the neighborhood sale"
    },
    "co_host_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "description": "Current co-host invite status"
    },
    "participant_origin": {
      "type": "string",
      "enum": [
        "neighborhood_invite",
        "standalone"
      ],
      "description": "How this participant listing was originally created"
    },
    "origin_sale_listing_id": {
      "type": "string",
      "description": "Original Neighborhood Sale that created this invite-based listing"
    },
    "host_warning_48h_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the host 48-hour warning was sent"
    },
    "host_cancellation_24h_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the host 24-hour cancellation message was sent"
    }
  },
  "required": [
    "ownerUserId",
    "listingType",
    "title",
    "city",
    "zip",
    "lat",
    "lng",
    "timeZoneId",
    "tier",
    "category",
    "startDateTime",
    "endDateTime"
  ]
}
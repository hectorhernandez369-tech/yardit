{
  "name": "PublicMapRecord",
  "type": "object",
  "properties": {
    "source_app": {
      "type": "string",
      "description": "Name of the sending app"
    },
    "source_record_id": {
      "type": "string",
      "description": "Stable record ID from the sending app"
    },
    "payload": {
      "type": "object",
      "description": "Public map-ready payload received from the sending app"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ],
      "default": "active",
      "description": "Current sync status"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last synced"
    }
  },
  "required": [
    "source_app",
    "source_record_id",
    "payload",
    "status"
  ]
}
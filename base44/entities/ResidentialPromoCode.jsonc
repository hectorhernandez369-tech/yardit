{
  "name": "ResidentialPromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code (stored uppercase, trimmed)"
    },
    "title": {
      "type": "string",
      "description": "Display title e.g. Lindsay Launch Weekend"
    },
    "description": {
      "type": "string",
      "description": "Internal description"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "expired",
        "draft"
      ],
      "default": "draft"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage"
      ],
      "default": "percentage"
    },
    "default_discount_percent": {
      "type": "number",
      "description": "Default discount percent e.g. 25"
    },
    "early_discount_enabled": {
      "type": "boolean",
      "default": false
    },
    "early_discount_limit": {
      "type": "number",
      "description": "Number of early uses allowed e.g. 50"
    },
    "early_discount_percent": {
      "type": "number",
      "description": "Percent for early uses e.g. 100"
    },
    "early_discount_used_count": {
      "type": "number",
      "default": 0
    },
    "max_total_uses": {
      "type": "number",
      "description": "Max total uses (null = unlimited)"
    },
    "total_used_count": {
      "type": "number",
      "default": 0
    },
    "per_user_limit": {
      "type": "number",
      "default": 1
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "applies_to_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Eligible tiers: featured, premium, marquee"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "nationwide",
        "state",
        "county",
        "city",
        "town",
        "zip",
        "custom"
      ],
      "default": "nationwide"
    },
    "coverage_state": {
      "type": "string"
    },
    "coverage_county": {
      "type": "string"
    },
    "coverage_city": {
      "type": "string"
    },
    "coverage_town": {
      "type": "string"
    },
    "coverage_zip": {
      "type": "string"
    },
    "coverage_rules": {
      "type": "object",
      "description": "Flexible coverage rules: { states, counties, cities, zips }"
    },
    "geographic_limit_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether geographic restrictions apply"
    },
    "geographic_limit_type": {
      "type": "string",
      "enum": [
        "none",
        "city_zip",
        "radius"
      ],
      "default": "none",
      "description": "Type of geographic restriction"
    },
    "eligible_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of eligible city names (for city_zip type)"
    },
    "eligible_zips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of eligible ZIP codes (for city_zip type)"
    },
    "geo_center_lat": {
      "type": "number",
      "description": "Center latitude for radius targeting"
    },
    "geo_center_lng": {
      "type": "number",
      "description": "Center longitude for radius targeting"
    },
    "geo_radius_miles": {
      "type": "number",
      "description": "Radius in miles for radius targeting"
    },
    "geo_display_label": {
      "type": "string",
      "description": "Human-readable location label for the coverage area"
    },
    "notes": {
      "type": "string"
    },
    "created_by_admin_id": {
      "type": "string"
    },
    "created_by_admin_email": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "title",
    "status",
    "discount_type",
    "default_discount_percent"
  ]
}
{
  "name": "ResidentialPromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code (stored uppercase, trimmed)"
    },
    "title": {
      "type": "string",
      "description": "Display title e.g. Lindsay Launch Weekend"
    },
    "description": {
      "type": "string",
      "description": "Internal description"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "expired",
        "draft"
      ],
      "default": "draft"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage"
      ],
      "default": "percentage"
    },
    "default_discount_percent": {
      "type": "number",
      "description": "Default discount percent e.g. 25"
    },
    "early_discount_enabled": {
      "type": "boolean",
      "default": false
    },
    "early_discount_limit": {
      "type": "number",
      "description": "Number of early uses allowed e.g. 50"
    },
    "early_discount_percent": {
      "type": "number",
      "description": "Percent for early uses e.g. 100"
    },
    "early_discount_used_count": {
      "type": "number",
      "default": 0
    },
    "early_visibility_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this promo grants listing-level Early Visibility using Coming Soon"
    },
    "early_visibility_days": {
      "type": "number",
      "default": 0,
      "description": "Number of days before the listing start date that visibility begins"
    },
    "max_total_uses": {
      "type": "number",
      "description": "Max total uses (null = unlimited)"
    },
    "total_used_count": {
      "type": "number",
      "default": 0
    },
    "per_user_limit": {
      "type": "number",
      "default": 1
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "applies_to_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Eligible tiers: featured, premium, marquee"
    },
    "coverage_type": {
      "type": "string",
      "enum": [
        "nationwide",
        "state",
        "county",
        "city",
        "town",
        "zip",
        "custom"
      ],
      "default": "nationwide"
    },
    "coverage_state": {
      "type": "string"
    },
    "coverage_county": {
      "type": "string"
    },
    "coverage_city": {
      "type": "string"
    },
    "coverage_town": {
      "type": "string"
    },
    "coverage_zip": {
      "type": "string"
    },
    "coverage_rules": {
      "type": "object",
      "description": "Flexible coverage rules: { states, counties, cities, zips }"
    },
    "geographic_limit_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether geographic restrictions apply"
    },
    "geographic_limit_type": {
      "type": "string",
      "enum": [
        "none",
        "city_zip",
        "radius",
        "polygon"
      ],
      "default": "none",
      "description": "Type of geographic restriction"
    },
    "eligible_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of eligible city names (legacy city/ZIP restriction)"
    },
    "eligible_zips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of eligible ZIP codes (legacy city/ZIP restriction)"
    },
    "geo_center_lat": {
      "type": "number",
      "description": "Center latitude for radius targeting"
    },
    "geo_center_lng": {
      "type": "number",
      "description": "Center longitude for radius targeting"
    },
    "geo_radius_miles": {
      "type": "number",
      "description": "Radius in miles for radius targeting"
    },
    "geo_polygon_coordinates": {
      "type": "array",
      "description": "Custom drawn geographic area as ordered latitude/longitude points",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "geo_display_label": {
      "type": "string",
      "description": "Human-readable location label for the coverage area"
    },
    "promo_door_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this promo appears as a branded discovery icon on the public map"
    },
    "promo_door_lat": {
      "type": "number",
      "description": "Custom promo door latitude for polygon promo discovery"
    },
    "promo_door_lng": {
      "type": "number",
      "description": "Custom promo door longitude for polygon promo discovery"
    },
    "promo_icon_logo_url": {
      "type": "string",
      "description": "Uploaded transparent PNG, PNG, or SVG promo discovery logo"
    },
    "promo_icon_size_px": {
      "type": "number",
      "default": 72,
      "description": "Public map promo icon size in pixels"
    },
    "promo_icon_glow_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the public promo icon uses a glow treatment"
    },
    "promo_icon_animation": {
      "type": "string",
      "enum": [
        "none",
        "pulse",
        "bounce",
        "float"
      ],
      "default": "none",
      "description": "Optional animation style for the public promo discovery icon"
    },
    "promo_min_zoom": {
      "type": "number",
      "default": 10,
      "description": "Minimum public map zoom level before this promo discovery icon appears"
    },
    "promo_discovery_config": {
      "type": "object",
      "description": "Future-ready promo discovery presentation options such as animation, sponsor artwork, seasonal branding, or treasure hunt metadata"
    },
    "notes": {
      "type": "string"
    },
    "created_by_admin_id": {
      "type": "string"
    },
    "created_by_admin_email": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "title",
    "status",
    "discount_type",
    "default_discount_percent"
  ]
}
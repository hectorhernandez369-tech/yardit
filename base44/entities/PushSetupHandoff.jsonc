{
  "name": "PushSetupHandoff",
  "type": "object",
  "properties": {
    "token_hash": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "push_setup"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token_hash",
    "user_id",
    "purpose",
    "expires_at",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "VoucherFraudReview",
  "type": "object",
  "properties": {
    "voucher_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "cleared",
        "revoked"
      ],
      "default": "open"
    },
    "disposition": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "voucher_id",
    "user_id",
    "status"
  ]
}
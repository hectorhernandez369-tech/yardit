{
  "name": "VendorNotificationSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who wants vendor check-in push alerts"
    },
    "vendor_account_id": {
      "type": "string",
      "description": "Vendor account to follow"
    },
    "radius_miles": {
      "type": "number",
      "default": 2
    },
    "subscription_enabled": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_notified_checkin_id": {
      "type": "string"
    },
    "last_notified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "vendor_account_id"
  ]
}
{
  "name": "Location",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "yard_sale",
        "neighborhood_yard_sale",
        "pop_up_event",
        "holiday_lights",
        "halloween_candy"
      ],
      "description": "Type of location"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "featured",
        "premium"
      ],
      "default": "free",
      "description": "Listing tier determining visibility and features"
    },
    "title": {
      "type": "string",
      "description": "Title or name of the location"
    },
    "display_title": {
      "type": "string",
      "description": "Title for holiday light displays"
    },
    "custom_icon_url": {
      "type": "string",
      "description": "Optional custom seasonal map icon URL"
    },
    "teaser_until": {
      "type": "string",
      "format": "date-time",
      "description": "When a custom seasonal teaser marker switches to its normal active appearance"
    },
    "account_email_hash": {
      "type": "string",
      "description": "Private one-way hash used to associate a seasonal location with an account email"
    },
    "street_address": {
      "type": "string",
      "description": "Street number and name (e.g., 123 Main St)"
    },
    "city": {
      "type": "string",
      "description": "City name"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "zip_code": {
      "type": "string",
      "description": "ZIP code"
    },
    "address": {
      "type": "string",
      "description": "Full address (computed field)"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate"
    },
    "description": {
      "type": "string",
      "description": "Additional details"
    },
    "start_date_time": {
      "type": "string",
      "format": "date-time",
      "description": "Start date and time of the listing"
    },
    "end_date_time": {
      "type": "string",
      "format": "date-time",
      "description": "End date and time of the listing"
    },
    "active_days": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Specific days when listing is featured (for Featured/Premium tiers)"
    },
    "viewing_start_time": {
      "type": "string",
      "description": "Start time for viewing lights (HH:MM)"
    },
    "viewing_end_time": {
      "type": "string",
      "description": "End time for viewing lights (HH:MM)"
    },
    "display_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether holiday lights display is currently active"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "inactive",
        "under_review",
        "suspended"
      ],
      "default": "active",
      "description": "Current status of the listing"
    },
    "safety_warning": {
      "type": "boolean",
      "default": false,
      "description": "Whether location has safety warning badge"
    },
    "contact_info": {
      "type": "string",
      "description": "Optional contact information"
    },
    "payment_amount": {
      "type": "number",
      "description": "Amount paid for listing"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the listing expires"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "free"
      ],
      "default": "free",
      "description": "Payment status"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of photo URLs"
    },
    "feed_impressions": {
      "type": "number",
      "default": 0,
      "description": "Number of times shown in feed"
    },
    "listing_views": {
      "type": "number",
      "default": 0,
      "description": "Number of times listing was viewed"
    },
    "map_pin_clicks": {
      "type": "number",
      "default": 0,
      "description": "Number of times map pin was clicked"
    }
  },
  "required": [
    "type",
    "latitude",
    "longitude"
  ]
}
{
  "name": "FounderMembership",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "residential_vip": {
      "type": "boolean",
      "default": true
    },
    "badge_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "active",
    "residential_vip",
    "badge_visible"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.badge_visible": true
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
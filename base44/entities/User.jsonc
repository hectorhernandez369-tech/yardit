{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Optional first name"
    },
    "last_name": {
      "type": "string",
      "description": "Optional last name"
    },
    "username": {
      "type": "string",
      "description": "Optional username"
    },
    "phone": {
      "type": "string",
      "description": "Optional phone number"
    },
    "login_provider": {
      "type": "string",
      "description": "Authentication provider used for signup or login"
    },
    "email_verified": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user's email is verified"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "Internal trust score for progressive trust actions"
    },
    "street_address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip_code": {
      "type": "string",
      "description": "ZIP code"
    },
    "address_lat": {
      "type": "number",
      "description": "Confirmed address latitude"
    },
    "address_lng": {
      "type": "number",
      "description": "Confirmed address longitude"
    },
    "address_confirmation_status": {
      "type": "string",
      "enum": [
        "unconfirmed",
        "confirmed"
      ],
      "default": "unconfirmed",
      "description": "Address confirmation state"
    },
    "address": {
      "type": "string",
      "description": "Legacy combined address field"
    },
    "has_primary_address": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has verified a primary physical address"
    },
    "primary_address": {
      "type": "string",
      "description": "Verified formatted primary address"
    },
    "primary_latitude": {
      "type": "number",
      "description": "Verified primary address latitude"
    },
    "primary_longitude": {
      "type": "number",
      "description": "Verified primary address longitude"
    },
    "primary_address_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the primary address was verified"
    },
    "address_verification_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user must verify a primary address before posting"
    },
    "listing_rules_agreed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user agreed to listing rules"
    },
    "isAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Admin status"
    },
    "accountStatus": {
      "type": "string",
      "enum": [
        "active",
        "warned",
        "suspended",
        "banned"
      ],
      "default": "active",
      "description": "Account status"
    },
    "statusUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Status expiration"
    }
  },
  "required": []
}
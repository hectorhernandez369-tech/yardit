{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Real first name"
    },
    "last_name": {
      "type": "string",
      "description": "Real last name"
    },
    "username": {
      "type": "string",
      "description": "Optional username"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "street_address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip_code": {
      "type": "string",
      "description": "ZIP code"
    },
    "address_lat": {
      "type": "number",
      "description": "Confirmed address latitude"
    },
    "address_lng": {
      "type": "number",
      "description": "Confirmed address longitude"
    },
    "address_confirmation_status": {
      "type": "string",
      "enum": [
        "unconfirmed",
        "confirmed"
      ],
      "default": "unconfirmed",
      "description": "Address confirmation state"
    },
    "address": {
      "type": "string",
      "description": "Legacy combined address field"
    },
    "isAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Admin status"
    },
    "accountStatus": {
      "type": "string",
      "enum": [
        "active",
        "warned",
        "suspended",
        "banned"
      ],
      "default": "active",
      "description": "Account status"
    },
    "statusUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Status expiration"
    }
  },
  "required": []
}
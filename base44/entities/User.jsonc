{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "address": {
      "type": "string",
      "description": "Address"
    },
    "isAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Admin status"
    },
    "accountStatus": {
      "type": "string",
      "enum": [
        "active",
        "warned",
        "suspended",
        "banned"
      ],
      "default": "active",
      "description": "Account status"
    },
    "statusUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Status expiration"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "address",
    "statusUntil"
  ]
}
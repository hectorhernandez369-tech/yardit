{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Optional first name"
    },
    "last_name": {
      "type": "string",
      "description": "Optional last name"
    },
    "username": {
      "type": "string",
      "description": "Optional username"
    },
    "phone": {
      "type": "string",
      "description": "Optional phone number"
    },
    "phone_number": {
      "type": "string",
      "description": "Optional phone number alias for account setup"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user accepted the current Terms of Service"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user accepted the Terms of Service"
    },
    "terms_version": {
      "type": "string",
      "description": "Terms of Service version accepted by the user"
    },
    "privacy_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user acknowledged the current Privacy Policy"
    },
    "privacy_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user acknowledged the Privacy Policy"
    },
    "privacy_version": {
      "type": "string",
      "description": "Privacy Policy version acknowledged by the user"
    },
    "community_guidelines_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user accepted the current Community Guidelines"
    },
    "community_guidelines_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user accepted the Community Guidelines"
    },
    "community_guidelines_version": {
      "type": "string",
      "description": "Community Guidelines version accepted by the user"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Optional profile photo URL"
    },
    "login_provider": {
      "type": "string",
      "description": "Authentication provider used for signup or login"
    },
    "email_verified": {
      "type": "boolean",
      "default": true,
      "description": "Whether the user's email is verified"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "Internal trust score for progressive trust actions"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal risk flags for admin review"
    },
    "moderation_notes": {
      "type": "string",
      "description": "Internal moderation notes"
    },
    "seller_verification_level": {
      "type": "string",
      "enum": [
        "basic",
        "verified",
        "trusted",
        "vendor_verified"
      ],
      "default": "basic",
      "description": "Future seller verification level"
    },
    "street_address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip_code": {
      "type": "string",
      "description": "ZIP code"
    },
    "address_lat": {
      "type": "number",
      "description": "Confirmed address latitude"
    },
    "address_lng": {
      "type": "number",
      "description": "Confirmed address longitude"
    },
    "address_confirmation_status": {
      "type": "string",
      "enum": [
        "unconfirmed",
        "confirmed"
      ],
      "default": "unconfirmed",
      "description": "Address confirmation state"
    },
    "address": {
      "type": "string",
      "description": "Legacy combined address field"
    },
    "has_primary_address": {
      "type": "boolean",
      "default": false,
      "description": "Legacy compatibility flag for verified primary physical address"
    },
    "primary_address_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the primary address is verified"
    },
    "primary_address": {
      "type": "string",
      "description": "Verified formatted primary address"
    },
    "primary_latitude": {
      "type": "number",
      "description": "Verified primary address latitude"
    },
    "primary_longitude": {
      "type": "number",
      "description": "Verified primary address longitude"
    },
    "primary_address_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the primary address was verified"
    },
    "primary_address_last_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the primary address was last changed"
    },
    "address_change_count": {
      "type": "number",
      "default": 0,
      "description": "Number of verified primary address changes"
    },
    "address_verification_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user must verify a primary address before posting"
    },
    "listing_rules_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user accepted listing rules"
    },
    "listing_rules_agreed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy timestamp when the user agreed to listing rules"
    },
    "isAdmin": {
      "type": "boolean",
      "default": false,
      "description": "Admin status"
    },
    "accountStatus": {
      "type": "string",
      "enum": [
        "active",
        "warned",
        "suspended",
        "banned"
      ],
      "default": "active",
      "description": "Account status"
    },
    "statusUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Status expiration"
    }
  },
  "required": []
}
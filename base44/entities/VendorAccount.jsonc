{
  "name": "VendorAccount",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Vendor business name"
    },
    "business_logo": {
      "type": "string",
      "description": "Business logo URL"
    },
    "business_category": {
      "type": "string",
      "description": "Vendor business category"
    },
    "description": {
      "type": "string",
      "description": "Short public vendor bio or business description"
    },
    "phone": {
      "type": "string",
      "description": "Public business phone number"
    },
    "location": {
      "type": "string",
      "description": "Public business location or service area"
    },
    "hero_background_color": {
      "type": "string",
      "default": "#FFFFFF",
      "description": "Business hero background color"
    },
    "email": {
      "type": "string",
      "description": "Public business email address"
    },
    "website": {
      "type": "string",
      "description": "Public business website URL"
    },
    "facebook_url": {
      "type": "string",
      "description": "Facebook profile or page URL"
    },
    "instagram_url": {
      "type": "string",
      "description": "Instagram profile URL"
    },
    "tiktok_url": {
      "type": "string",
      "description": "TikTok profile URL"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Public business photo gallery URLs"
    },
    "featured_photo_url": {
      "type": "string",
      "description": "Featured public business photo URL"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "vendor_tier": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "growth"
      ],
      "default": "starter",
      "description": "Vendor subscription tier"
    },
    "extra_users_count": {
      "type": "number",
      "default": 0,
      "description": "Additional paid authorized users"
    },
    "extra_pins_count": {
      "type": "number",
      "default": 0,
      "description": "Additional paid truck pins"
    },
    "current_authorized_users": {
      "type": "number",
      "default": 0,
      "description": "Current authorized user count"
    },
    "current_vendor_pins": {
      "type": "number",
      "default": 0,
      "description": "Current vendor pin count"
    },
    "vendor_dashboard_passcode_hash": {
      "type": "string",
      "description": "Hashed Vendor Dashboard passcode"
    },
    "passcode_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Vendor Dashboard passcode was last changed"
    },
    "passcode_updated_by": {
      "type": "string",
      "description": "User ID who last changed the Vendor Dashboard passcode"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the vendor account is active"
    }
  },
  "required": [
    "business_name",
    "owner_user_id",
    "vendor_tier"
  ]
}
{
  "name": "VendorAccount",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Vendor business name"
    },
    "business_logo": {
      "type": "string",
      "description": "Business logo URL"
    },
    "business_category": {
      "type": "string",
      "description": "Vendor business category"
    },
    "business_tax_id": {
      "type": "string",
      "description": "EIN, 501(c)(3), or Business Tax ID in formatted form"
    },
    "business_street_address": {
      "type": "string",
      "description": "Business street address"
    },
    "business_city": {
      "type": "string",
      "description": "Business city"
    },
    "business_state": {
      "type": "string",
      "description": "Business state"
    },
    "business_zip_code": {
      "type": "string",
      "description": "Business ZIP code"
    },
    "business_address": {
      "type": "string",
      "description": "Combined business address"
    },
    "latitude": {
      "type": "number",
      "description": "Business latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Business longitude"
    },
    "owner_name": {
      "type": "string",
      "description": "Vendor owner name"
    },
    "account_number": {
      "type": "string",
      "description": "Vendor account number"
    },
    "is_verified_vendor": {
      "type": "boolean",
      "default": false,
      "description": "Whether the vendor has been verified"
    },
    "is_demo_vendor": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a demo vendor account"
    },
    "description": {
      "type": "string",
      "description": "Short public vendor bio or business description"
    },
    "phone": {
      "type": "string",
      "description": "Public business phone number"
    },
    "location": {
      "type": "string",
      "description": "Public business location or service area"
    },
    "hero_background_color": {
      "type": "string",
      "default": "#FFFFFF",
      "description": "Business hero background color"
    },
    "email": {
      "type": "string",
      "description": "Public business email address"
    },
    "website": {
      "type": "string",
      "description": "Public business website URL"
    },
    "facebook_url": {
      "type": "string",
      "description": "Facebook profile or page URL"
    },
    "instagram_url": {
      "type": "string",
      "description": "Instagram profile URL"
    },
    "tiktok_url": {
      "type": "string",
      "description": "TikTok profile URL"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Public business photo gallery URLs"
    },
    "featured_photo_url": {
      "type": "string",
      "description": "Featured public business photo URL"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "vendor_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "growth",
        "event_organizer"
      ],
      "default": "free",
      "description": "Vendor subscription tier"
    },
    "vendor_setup_status": {
      "type": "string",
      "enum": [
        "setup_required",
        "in_progress",
        "complete"
      ],
      "default": "setup_required",
      "description": "Vendor onboarding/setup status"
    },
    "setup_tier_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the vendor confirmed their setup tier selection"
    },
    "setup_dashboard_entered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the vendor entered the dashboard during setup"
    },
    "extra_users_count": {
      "type": "number",
      "default": 0,
      "description": "Additional paid authorized users"
    },
    "extra_pins_count": {
      "type": "number",
      "default": 0,
      "description": "Additional paid truck pins"
    },
    "current_authorized_users": {
      "type": "number",
      "default": 0,
      "description": "Current authorized user count"
    },
    "current_vendor_pins": {
      "type": "number",
      "default": 0,
      "description": "Current vendor pin count"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the vendor account is active"
    }
  },
  "required": [
    "business_name",
    "owner_user_id",
    "vendor_tier"
  ]
}
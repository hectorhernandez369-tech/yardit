{
  "name": "LeagueEventGame",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Linked Yardit VendorEvent ID"
    },
    "league_game_id": {
      "type": "string",
      "description": "Existing LeagueGame ID"
    },
    "league_account_id": {
      "type": "string",
      "description": "League/Team VendorAccount ID"
    },
    "league_event_field_id": {
      "type": "string",
      "description": "LeagueEventField assignment for this game within this specific event"
    },
    "field_name_snapshot": {
      "type": "string",
      "description": "Field name captured for display when this event-game link was assigned"
    },
    "spot_id": {
      "type": "string",
      "description": "Optional legacy/public schedule spot relationship"
    },
    "field_name": {
      "type": "string",
      "description": "Optional legacy field label for compatibility; league_event_field_id is authoritative"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "event_id",
    "league_game_id",
    "league_account_id"
  ]
}
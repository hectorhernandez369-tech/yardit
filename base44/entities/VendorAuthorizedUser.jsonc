{
  "name": "VendorAuthorizedUser",
  "type": "object",
  "properties": {
    "vendor_account_id": {
      "type": "string",
      "description": "Vendor account ID"
    },
    "authorized_email": {
      "type": "string",
      "description": "Authorized user email"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "assigned_pin_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assigned vendor pin IDs"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "active",
        "denied",
        "inactive",
        "removed"
      ],
      "default": "pending",
      "description": "Authorized user status. pending = invite sent, accepted/active = has access, denied/removed/inactive = no access"
    },
    "added_by_owner_user_id": {
      "type": "string",
      "description": "Owner user ID who added this user"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invite was sent"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user accepted the invite"
    },
    "denied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user denied the invite"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user was removed by the owner"
    },
    "invite_notification_id": {
      "type": "string",
      "description": "Notification ID sent to the invited user"
    }
  },
  "required": [
    "vendor_account_id",
    "authorized_email",
    "status"
  ]
}
{
  "name": "VendorDeal",
  "type": "object",
  "properties": {
    "vendor_account_id": { "type": "string", "description": "Vendor account ID" },
    "title": { "type": "string", "description": "Short public deal title" },
    "description": { "type": "string", "description": "Deal details and redemption instructions" },
    "promo_code": { "type": "string", "description": "Optional code customers can mention" },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "inactive", "expired"], "default": "active" },
    "created_by_user_id": { "type": "string" }
  },
  "required": ["vendor_account_id", "title", "status"]
}
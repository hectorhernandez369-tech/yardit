{
  "name": "VendorEvent",
  "type": "object",
  "properties": {
    "organizer_user_id": {
      "type": "string",
      "description": "Organizer user ID"
    },
    "organizer_business_id": {
      "type": "string",
      "description": "VendorAccount ID for the organizer"
    },
    "organizer_business_name": {
      "type": "string",
      "description": "Organizer business name"
    },
    "organizer_logo": {
      "type": "string",
      "description": "Organizer logo URL"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "category": {
      "type": "string",
      "description": "Event category"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "single",
        "multi_spot",
        "multi_location"
      ],
      "default": "single",
      "description": "Vendor event type"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_payment",
        "published",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Vendor event status"
    },
    "visibility_status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "coming_soon",
        "active",
        "completed",
        "cancelled"
      ],
      "description": "Computed visibility/lifecycle status for display and map logic"
    },
    "public_contact_visibility": {
      "type": "string",
      "enum": [
        "inherit",
        "show",
        "hide"
      ],
      "default": "inherit",
      "description": "Event-level override for public organizer phone, email and website visibility"
    },
    "open_to_vendors": {
      "type": "boolean",
      "default": false,
      "description": "Whether vendors can request to join"
    },
    "vendor_invitation_description": {
      "type": "string",
      "description": "Vendor-facing invitation text"
    },
    "vendor_fee_type": {
      "type": "string",
      "enum": [
        "none",
        "general_fee",
        "set_space_fee"
      ],
      "default": "none",
      "description": "Vendor attendance fee type"
    },
    "vendor_payment_type": {
      "type": "string",
      "enum": [
        "reserve_deposit",
        "pay_full_amount",
        "no_online_payment"
      ],
      "default": "reserve_deposit",
      "description": "How vendors pay to reserve their event space"
    },
    "reserve_deposit_percentage": {
      "type": "number",
      "default": 20,
      "description": "Percentage vendors pay online to reserve their spot"
    },
    "vendor_general_fee": {
      "type": "number",
      "description": "General vendor attendance fee"
    },
    "vendor_space_options": {
      "type": "array",
      "description": "Custom space options for set space fees",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "depth": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "allow_custom_spaces": {
      "type": "boolean",
      "default": false,
      "description": "Whether custom vendor spaces are allowed"
    },
    "vendor_instructions": {
      "type": "string",
      "description": "Instructions for attending vendors"
    },
    "vendor_deadline": {
      "type": "string",
      "format": "date",
      "description": "Vendor signup deadline"
    },
    "max_vendors": {
      "type": "number",
      "description": "Optional maximum vendor count"
    },
    "startDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "Event start date/time"
    },
    "endDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "Event end date/time"
    },
    "earlyVisibilityStartDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "When the event can appear before it starts"
    },
    "display_address": {
      "type": "string",
      "description": "Public display address"
    },
    "geocoded_address": {
      "type": "string",
      "description": "Geocoded/reference address"
    },
    "latitude": {
      "type": "number",
      "description": "Event latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Event longitude"
    },
    "timeZoneId": {
      "type": "string",
      "description": "IANA timezone"
    },
    "radius_feet": {
      "type": "number",
      "description": "Event area radius in feet"
    },
    "highlights": {
      "type": "array",
      "description": "Labeled map area overlays (staging, entrance, vendor area, etc.) drawn by the organizer and shown to partners/vendors",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "circle",
              "rectangle",
              "triangle"
            ]
          },
          "title": {
            "type": "string"
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "[lat,lng] for circle"
          },
          "radius": {
            "type": "number",
            "description": "Circle radius in meters"
          },
          "bounds": {
            "type": "array",
            "description": "[[lat,lng],[lat,lng]] SW/NE for rectangle",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "points": {
            "type": "array",
            "description": "[[lat,lng],...] vertices for triangle",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Event photo URLs"
    },
    "flyer_url": {
      "type": "string",
      "description": "Public event flyer image or PDF URL"
    },
    "logo": {
      "type": "string",
      "description": "Event logo URL"
    },
    "icon": {
      "type": "string",
      "description": "Event icon key or URL"
    },
    "coming_soon_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time when the event starts appearing as Coming Soon on the map"
    },
    "promotion_included_days": {
      "type": "number",
      "description": "Number of promotion days included in the vendor tier at time of creation"
    },
    "promotion_max_days": {
      "type": "number",
      "description": "Maximum promotion days allowed by the vendor tier at time of creation"
    },
    "promotion_selected_days": {
      "type": "number",
      "description": "Number of days before event start that the user selected for Coming Soon"
    },
    "promotion_upgrade_days": {
      "type": "number",
      "default": 0,
      "description": "Additional days beyond included promotion that require an upgrade"
    },
    "promotion_upgrade_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether a promotion upgrade is required for the selected Coming Soon date"
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "none",
        "included",
        "upgrade_required",
        "paid"
      ],
      "default": "none",
      "description": "Current state of the promotion/Coming Soon setup"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organizer_user_id",
    "organizer_business_id",
    "title",
    "event_type",
    "status",
    "startDateTime",
    "endDateTime",
    "latitude",
    "longitude"
  ]
}
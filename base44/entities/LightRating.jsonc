{
  "name": "LightRating",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "ID of the holiday lights location"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user rating"
    },
    "rating_value": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "One to five Christmas stars"
    },
    "season_year": {
      "type": "integer",
      "description": "Year of the holiday season"
    },
    "user_id": {
      "type": "string",
      "description": "Authenticated voter ID"
    }
  },
  "required": [
    "listing_id",
    "user_email",
    "rating_value",
    "season_year"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

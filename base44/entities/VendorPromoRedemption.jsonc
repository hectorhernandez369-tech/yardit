{
  "name": "VendorPromoRedemption",
  "type": "object",
  "properties": {
    "promo_code_id": {
      "type": "string",
      "description": "VendorPromoCode ID"
    },
    "promo_code": {
      "type": "string",
      "description": "The code string (cached)"
    },
    "user_id": {
      "type": "string",
      "description": "User ID who redeemed the code"
    },
    "user_email": {
      "type": "string",
      "description": "User email (cached)"
    },
    "vendor_account_id": {
      "type": "string",
      "description": "VendorAccount ID"
    },
    "vendor_business_name": {
      "type": "string",
      "description": "Cached vendor business name at time of redemption"
    },
    "tier_selected": {
      "type": "string",
      "description": "Tier key the promo was applied to"
    },
    "discount_type": {
      "type": "string",
      "description": "Type of discount applied"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount value applied"
    },
    "discount_applied_dollars": {
      "type": "number",
      "description": "Actual dollar discount applied"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "benefits_expire_at": {
      "type": "string",
      "format": "date-time",
      "description": "Computed expiration of promo benefits (null = no expiration)"
    },
    "redemption_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "removed",
        "canceled",
        "forfeited"
      ],
      "default": "active",
      "description": "Current lifecycle status of this redemption"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When admin removed this promo from the account"
    },
    "removed_by_admin_id": {
      "type": "string",
      "description": "Admin who removed it"
    },
    "removed_by_admin_email": {
      "type": "string"
    },
    "slot_recovered": {
      "type": "boolean",
      "default": false,
      "description": "Whether removal re-opened a redemption slot"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID if available"
    }
  },
  "required": [
    "promo_code_id",
    "user_id",
    "vendor_account_id",
    "tier_selected",
    "redeemed_at"
  ]
}
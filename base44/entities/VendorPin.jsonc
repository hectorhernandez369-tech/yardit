{
  "name": "VendorPin",
  "type": "object",
  "properties": {
    "vendor_account_id": {
      "type": "string",
      "description": "Vendor account ID"
    },
    "pin_name": {
      "type": "string",
      "description": "Truck or location profile name"
    },
    "pin_logo_url": {
      "type": "string",
      "description": "Logo URL for this pin"
    },
    "pin_icon_url": {
      "type": "string",
      "description": "Icon URL for this pin"
    },
    "pin_icon_style": {
      "type": "string",
      "enum": [
        "default",
        "truck_logo"
      ],
      "default": "default",
      "description": "Whether to use the default map pin or the truck logo as the map icon"
    },
    "description": {
      "type": "string",
      "description": "Pin profile description"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this pin profile is active"
    },
    "assigned_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Authorized user emails assigned to this pin"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Planned date for this pin's scheduled appearance"
    },
    "scheduled_start_time": {
      "type": "string",
      "description": "Scheduled start time (HH:MM local)"
    },
    "scheduled_end_time": {
      "type": "string",
      "description": "Scheduled end time (HH:MM local)"
    },
    "recurring_schedule": {
      "type": "array",
      "description": "Recurring weekly schedule rows for automatic pin visibility by weekday",
      "items": {
        "type": "object",
        "properties": {
          "day_of_week": {
            "type": "number",
            "description": "0=Sunday, 6=Saturday"
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "start_time": {
            "type": "string",
            "description": "Start time HH:MM local"
          },
          "end_time": {
            "type": "string",
            "description": "End time HH:MM local"
          }
        }
      }
    },
    "scheduled_location_label": {
      "type": "string",
      "description": "Human-readable location label for the scheduled appearance"
    },
    "scheduled_lat": {
      "type": "number",
      "description": "Latitude of the scheduled location"
    },
    "scheduled_lng": {
      "type": "number",
      "description": "Longitude of the scheduled location"
    },
    "scheduled_by_user_id": {
      "type": "string",
      "description": "User ID who set up this schedule"
    },
    "scheduled_by_name": {
      "type": "string",
      "description": "Display name of whoever scheduled this pin"
    },
    "schedule_status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "active",
        "completed",
        "canceled"
      ],
      "default": "draft",
      "description": "Lifecycle status of the current schedule slot. Scheduled/active schedules can drive pin visibility when the configured time window is active."
    },
    "schedule_notes": {
      "type": "string",
      "description": "Optional internal notes about this schedule slot"
    }
  },
  "required": [
    "vendor_account_id",
    "pin_name"
  ]
}
{
  "name": "HalloweenLike",
  "type": "object",
  "properties": {
    "halloween_listing_id": {
      "type": "string",
      "description": "Location ID for the liked Halloween listing"
    },
    "user_id": {
      "type": "string",
      "description": "Authenticated user who liked the Halloween listing"
    },
    "like_key": {
      "type": "string",
      "description": "Server-generated Halloween listing and user relationship key"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "halloween_listing_id",
    "user_id",
    "like_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
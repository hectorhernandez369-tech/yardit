{
  "name": "EventScheduleEntry",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Parent VendorEvent ID"
    },
    "spot_id": {
      "type": "string",
      "description": "Optional EventSpot ID for field/flag-specific schedules"
    },
    "field_name": {
      "type": "string",
      "description": "Field, flag, area, or Main Event name"
    },
    "title": {
      "type": "string",
      "description": "Activity, game, show, or schedule item title"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Schedule start time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Optional schedule end time"
    },
    "notes": {
      "type": "string",
      "description": "Optional schedule notes"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Optional schedule date"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "field_name",
    "title",
    "start_time"
  ]
}
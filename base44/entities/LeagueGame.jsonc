{
  "name": "LeagueGame",
  "type": "object",
  "properties": {
    "vendor_account_id": {
      "type": "string",
      "description": "League/Team organizer account ID that owns this game"
    },
    "league_event_id": {
      "type": "string",
      "description": "Linked League VendorEvent ID this game is scheduled under"
    },
    "league_event_field_id": {
      "type": "string",
      "description": "Primary LeagueEventField assignment for this game"
    },
    "field_name_snapshot": {
      "type": "string",
      "description": "Field name captured when the game was assigned, for display history. Does not replace the league_event_field_id relationship."
    },
    "league_name": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "age_group": {
      "type": "string"
    },
    "game_title": {
      "type": "string",
      "description": "Game title or matchup"
    },
    "home_team": {
      "type": "string"
    },
    "away_team": {
      "type": "string"
    },
    "home_team_id": {
      "type": "string"
    },
    "away_team_id": {
      "type": "string"
    },
    "home_town": {
      "type": "string"
    },
    "away_town": {
      "type": "string"
    },
    "game_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled start (ISO). Aliases scheduled_start."
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled end (ISO). Aliases scheduled_end."
    },
    "field_name": {
      "type": "string",
      "description": "Legacy free-text field label; league_event_field_id is the authoritative assignment."
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "halftime",
        "delayed",
        "postponed",
        "cancelled",
        "final"
      ],
      "default": "upcoming",
      "description": "Game status (aliases game_status)"
    },
    "home_score": {
      "type": "number",
      "default": 0
    },
    "away_score": {
      "type": "number",
      "default": 0
    },
    "period_label": {
      "type": "string"
    },
    "period_number": {
      "type": "number"
    },
    "clock_display": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "score_state": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "locked"
      ],
      "default": "draft"
    },
    "score_submitted_by_user_id": {
      "type": "string"
    },
    "score_submitted_by_email": {
      "type": "string"
    },
    "score_submitted_by_account_id": {
      "type": "string"
    },
    "score_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_unlocked_by_user_id": {
      "type": "string"
    },
    "score_unlock_reason": {
      "type": "string"
    },
    "source_import_id": {
      "type": "string"
    },
    "source_row_key": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "vendor_account_id",
    "game_title"
  ]
}
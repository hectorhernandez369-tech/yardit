{
  "name": "LeagueGame",
  "type": "object",
  "properties": {
    "vendor_account_id": {
      "type": "string",
      "description": "Organizer account ID that owns this game"
    },
    "field_name": {
      "type": "string",
      "description": "Field, court, or location name"
    },
    "game_title": {
      "type": "string",
      "description": "Game title or matchup"
    },
    "home_team": {
      "type": "string",
      "description": "Home team name"
    },
    "away_team": {
      "type": "string",
      "description": "Away team name"
    },
    "game_date": {
      "type": "string",
      "format": "date",
      "description": "Game date"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Game start datetime"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Game end datetime"
    },
    "notes": {
      "type": "string",
      "description": "Optional game notes"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order from import"
    }
  },
  "required": [
    "vendor_account_id",
    "game_title"
  ]
}
{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who owns these push preferences"
    },
    "push_enabled": {
      "type": "boolean",
      "default": false
    },
    "alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "account_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "billing_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "approval_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "safety_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "support_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "policy_alerts_push_enabled": {
      "type": "boolean",
      "default": true
    },
    "listings_near_me_push_enabled": {
      "type": "boolean",
      "default": false
    },
    "listings_near_me_radius_miles": {
      "type": "number",
      "default": 2
    },
    "vendor_near_me_push_enabled": {
      "type": "boolean",
      "default": false
    },
    "vendor_near_me_radius_miles": {
      "type": "number",
      "default": 2
    },
    "marketing_push_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ]
}
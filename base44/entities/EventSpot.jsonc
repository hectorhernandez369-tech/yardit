{
  "name": "EventSpot",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Parent VendorEvent ID"
    },
    "title": {
      "type": "string",
      "description": "Public flag or spot name"
    },
    "label": {
      "type": "string",
      "description": "Optional short spot label"
    },
    "icon_key": {
      "type": "string",
      "default": "flag",
      "description": "Map-friendly icon key for this flag"
    },
    "description": {
      "type": "string",
      "description": "Spot description"
    },
    "category": {
      "type": "string",
      "description": "Optional flag category for future grouping/filtering"
    },
    "mini_schedule": {
      "type": "string",
      "description": "Optional spot-specific schedule"
    },
    "schedule_entries": {
      "type": "array",
      "description": "Activity/game/show schedule entries for this flag",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "sort_order": {
            "type": "number"
          }
        }
      }
    },
    "photo": {
      "type": "string",
      "description": "Spot photo URL"
    },
    "latitude": {
      "type": "number",
      "description": "Spot latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Spot longitude"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "title",
    "latitude",
    "longitude"
  ]
}
{
  "name": "Finalize Neighborhood Co-Host Invite",
  "description": "Sends the selected helper co-host invite after a Neighborhood Sale is created.",
  "trigger": {
    "condition": "${ ((.trigger.data.listingType == \"neighborhood_sale\") and (.trigger.data.co_host_user_id != null and .trigger.data.co_host_user_id != \"\" and .trigger.data.co_host_user_id != [] and .trigger.data.co_host_user_id != {}) and (.trigger.data.co_host_status == \"pending\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Listing"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "finalize_neighborhood_co_host_invite",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "finalizeNeighborhoodCoHostInvite",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "finalizeNeighborhoodCoHostInvite"
  }
}